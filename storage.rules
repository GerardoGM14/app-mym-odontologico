rules_version = '2';

// Usa el mismo perfil de Firestore (usuarios/{uid}) que firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esActivo() {
      return request.auth != null && perfil().activo == true;
    }
    function esAdmin() {
      return esActivo() && perfil().rol == 'admin';
    }

    match /clientes/{clienteId}/archivos/{archivo} {
      allow read: if esActivo();
      // Subir (máx. 20 MB) y borrar solo administradores.
      allow write: if esAdmin()
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }
  }
}
