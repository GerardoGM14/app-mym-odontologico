---
// Pie de página. Se muestra dentro de la última sección (Seccion6), sobre su fondo negro.
import { clinica, sedesPie, urlWhatsappContacto } from '../data/clinica';
import Icono from './Icono.astro';

const enlaces = [
  { texto: 'Nosotros', href: '#nosotros' },
  { texto: 'Servicios', href: '#servicios' },
  { texto: '¿Por qué elegirnos?', href: '#por-que-elegirnos' },
  { texto: 'Visítanos', href: '#visitanos' },
];

// Íconos de redes (rellenos). Si la red no tiene enlace en clinica.ts, el ícono se muestra sin enlace.
const redes = [
  {
    nombre: 'Facebook',
    url: clinica.redes.facebook,
    viewBox: '0 0 320 512',
    d: 'M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z',
  },
  {
    nombre: 'TikTok',
    url: clinica.redes.tiktok,
    viewBox: '0 0 448 512',
    d: 'M448 209.91a210.06 210.06 0 0 1-122.77-39.25v178.72A162.55 162.55 0 1 1 185 188.31v89.89a74.62 74.62 0 1 0 52.23 71.18V0h88a121.18 121.18 0 0 0 1.86 22.17A122.18 122.18 0 0 0 381 102.39a121.43 121.43 0 0 0 67 20.14z',
  },
];
---

<footer class="contenedor relative pb-10">
  <!-- Línea dorada superior. -->
  <span class="linea-dorada linea-dorada-completa" aria-hidden="true"></span>

  <div class="grid gap-12 pt-10 pb-12 md:grid-cols-[1fr_1.4fr_auto] md:gap-10">
    <!-- Logo y redes -->
    <div class="flex flex-col gap-8">
      <img src="/logo-sello-claro.png" alt={`${clinica.nombre} · ${clinica.especialidad}`} width="480" height="475" loading="lazy" class="h-44 w-44 object-contain" />
      <div class="flex gap-3">
        <a
          href={redes[0].url || undefined}
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          class="grid h-11 w-11 place-items-center rounded-full bg-white/[0.08] text-white transition-colors hover:bg-white/15"
        >
          <svg viewBox={redes[0].viewBox} class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true"><path d={redes[0].d} /></svg>
        </a>
        <a
          href={clinica.redes.instagram || undefined}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          class="grid h-11 w-11 place-items-center rounded-full bg-white/[0.08] text-white transition-colors hover:bg-white/15"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
        </a>
        <a
          href={redes[1].url || undefined}
          target="_blank"
          rel="noopener"
          aria-label="TikTok"
          class="grid h-11 w-11 place-items-center rounded-full bg-white/[0.08] text-white transition-colors hover:bg-white/15"
        >
          <svg viewBox={redes[1].viewBox} class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true"><path d={redes[1].d} /></svg>
        </a>
      </div>
    </div>

    <!-- Sedes y contacto -->
    <div class="flex flex-col gap-10 text-[15px]">
      <div>
        <p class="flex items-center gap-2 text-sm font-medium text-[#C1A071]">
          <Icono nombre="ubicacion" class="h-[18px] w-[18px]" />Sedes
        </p>
        <ul class="mt-3 space-y-1.5">
          {sedesPie.map((sede) => (
            <li><span class="text-white">{sede.zona}:</span> <span class="text-[#D5D6D6]">{sede.direccion}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="flex items-center gap-2 text-sm font-medium text-[#C1A071]">
          <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21l1.7-4.6A8.5 8.5 0 1 1 7.6 19.3z" />
            <path d="M9 10c.5 2 2.5 4 4.5 4.5l1-1.2 1.8.9c-.3 1-1.3 1.8-2.3 1.6C11 15.3 8.7 13 8.2 10.5c-.2-1 .6-2 1.6-2.3l.9 1.8z" />
          </svg>
          Contacto
        </p>
        <a href={urlWhatsappContacto} target="_blank" rel="noopener" class="mt-3 inline-block text-white tabular-nums hover:text-[#C1A071]">
          {clinica.telefonoContacto}
        </a>
      </div>
    </div>

    <!-- Navegación -->
    <nav aria-label="Pie de página">
      <ul class="flex flex-col gap-5 text-[15px] md:pt-3">
        {enlaces.map((e) => <li><a href={e.href} class="text-white transition-colors hover:text-[#C1A071]">{e.texto}</a></li>)}
        <li>
          <a href={clinica.urlPlataforma} class="inline-flex items-center gap-2 text-[#C1A071] transition-colors hover:text-oro-300">
            Acceso del personal <Icono nombre="flecha" class="h-4 w-4" />
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Línea fina inferior y derechos reservados. -->
  <div class="border-t border-white/10 pt-7">
    <p class="text-sm text-tinta-300">© {new Date().getFullYear()} M&amp;M Odontología integral. Todos los derechos reservados.</p>
  </div>
</footer>
