---
import { consultorios } from '../data/clinica';
import TarjetaSede from './TarjetaSede.astro';
---

<section id="visitanos" class="relative isolate overflow-hidden bg-[#FFFCF5]">
  <!-- Fondo: public/background_seccion5.png con un velo crema (#FFFCF5) encima. -->
  <img
    src="/background_seccion5.png"
    alt=""
    width="1528"
    height="1035"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-[#FFFCF5]/85"></div>

  <div class="contenedor relative pt-14 pb-24 md:pt-16">
    <!-- Título a la izquierda con la línea dorada solo a la derecha (mismo estilo que "NUESTROS SERVICIOS"). -->
    <div class="flex items-center gap-6 md:gap-10">
      <h2 class="shrink-0 font-newsreader text-lg font-normal tracking-wide text-[#B58D55] [font-optical-sizing:auto] md:text-xl">
        VISÍTANOS
      </h2>
      <span class="linea-dorada linea-dorada-derecha" aria-hidden="true"></span>
    </div>

    <!-- Encabezado en dos columnas: título a la izquierda y descripción a la derecha. -->
    <div class="mt-6 flex flex-col gap-5 md:flex-row md:items-start md:justify-between md:gap-12">
      <h3 class="text-2xl leading-[1.1] font-medium text-[#000000] md:text-3xl">Visita nuestros consultorios</h3>
      <p class="max-w-xl text-base leading-relaxed text-[#232424]">
        Encuentra la sede que mejor se adapte a ti. Consulta nuestras direcciones y descubre cómo llegar a cada uno de
        nuestros consultorios.
      </p>
    </div>

    <!-- Tarjetas de las sedes (datos en src/data/clinica.ts). -->
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {consultorios.map((sede) => <TarjetaSede {...sede} />)}
    </div>
  </div>
</section>
